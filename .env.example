APP_NAME=ShopWise Agent API
APP_VERSION=v1
APP_DEBUG=false
APP_API_PREFIX=/api/v1

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HTTPS=false
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT=5.0

VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_COLLECTION=default

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shopwise

EMBEDDING_PROVIDER=huggingface
EMBEDDING_DIMENSION=384
EMBEDDING_HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_HUGGINGFACE_DEVICE=
EMBEDDING_GEMINI_MODEL=text-embedding-004
EMBEDDING_GEMINI_API_KEY=