APP_NAME=ShopWise Agent API
APP_VERSION=v1
APP_DEBUG=false
APP_API_PREFIX=/api/v1

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HTTPS=false
QDRANT_PREFER_GRPC=false
QDRANT_TIMEOUT=5.0

VECTOR_DB_PROVIDER=qdrant
VECTOR_DB_COLLECTION=default

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shopwise

EMBEDDING_PROVIDER=huggingface
EMBEDDING_DIMENSION=384
EMBEDDING_HUGGINGFACE_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_HUGGINGFACE_DEVICE=
EMBEDDING_GEMINI_MODEL=text-embedding-004
EMBEDDING_GEMINI_API_KEY=

LLM_PROVIDER=openrouter
LLM_OPENROUTER_MODEL=openrouter/auto
LLM_OPENROUTER_API_KEY=
LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_GEMINI_MODEL=gemini-2.5-flash
LLM_GEMINI_API_KEY=
LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_GROQ_MODEL=llama-3.3-70b-versatile
LLM_GROQ_API_KEY=
LLM_GROQ_BASE_URL=https://api.groq.com/openai/v1

AGENT_MEMORY_SUMMARY_THRESHOLD=20
AGENT_MEMORY_RECENT_MESSAGES=10

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ShopWise

EVAL_K_VALUES=[1, 3, 5]
EVAL_DEFAULT_LIMIT=5
EVAL_DATASET_PATH=eval/data/eval_queries.jsonl
EVAL_REPORT_DIR=eval/reports